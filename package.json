{
  "name": "foss-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-offerings.mjs && node scripts/sync-repository-metadata.mjs && node scripts/build-wikis.mjs && vite build && node scripts/build-og.mjs --check && node scripts/prerender.mjs && node scripts/spa-fallback.mjs",
    "lint": "oxlint",
    "test": "node --test scripts/tests/*.test.mjs",
    "preview": "vite preview",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "data": "node scripts/build-data.mjs",
    "og": "node scripts/build-og.mjs",
    "og:check": "node scripts/build-og.mjs --check",
    "views:check": "node scripts/check-graph-views.mjs",
    "probe": "node scripts/probe-deployed.mjs",
    "offers:check": "node scripts/check-offerings.mjs",
    "repositories:sync": "node scripts/sync-repository-metadata.mjs",
    "probe:links": "node scripts/probe-resource-links.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "description": "导航 + Wiki + 知识图谱三合一的免费/开源资源库"
}
